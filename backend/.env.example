# Koneksi PostgreSQL (Aiven). Tanpa nilai ini, API /api/* mengembalikan 503
# dan halaman login otomatis memakai akun demo (mock).
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=defaultdb
PGSSL=true

# Port server API (default 4000)
PORT=4000

# Secret penandatangan JWT (wajib, string acak panjang)
JWT_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=7
# URL frontend (redirect Google SSO & tautan reset password)
FRONTEND_URL=http://localhost:3000
# Google SSO (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Job latar belakang (eskalasi downtime, cek defect rate). false = nonaktif
JOBS_ENABLED=true
# Ukuran pool koneksi PostgreSQL (serverless/Vercel: kecil, mis. 3)
PGPOOL_MAX=10
# Secret untuk endpoint /api/v1/internal/cron/:job (Vercel Cron / cron eksternal)
CRON_SECRET=
